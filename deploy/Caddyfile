yanhaoo.com {
    encode zstd gzip
    request_body {
        max_size 2MB
    }
    @legacyGame path /game /game/*
    redir @legacyGame https://game.yanhaoo.com/ 308
    @legacyGameAssets path /game-assets/*
    redir @legacyGameAssets https://game.yanhaoo.com{uri} 308
    handle {
        reverse_proxy hub:8000
    }
}
game.yanhaoo.com {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
    handle_path /game-assets/* {
        root * /srv/lab/.game-releases
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin https://yanhaoo.com
        file_server {
            precompressed br gzip
        }
    }
    handle {
        root * /srv/lab/game
        header Cache-Control "no-cache"
        file_server {
            precompressed br gzip
        }
    }
}
