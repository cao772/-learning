# Generate independently for production. Never commit actual values.
HUB_SECRET=replace-with-random-48-byte-secret
HUB_PASSWORD_HASH=replace-with-werkzeug-password-hash
HUB_INGEST_TOKEN=replace-with-random-sync-token
HUB_IMAGE_TAG=replace-with-tested-git-sha

# Optional. The collector NEVER calls a translation API. Owner must click Translate.
# Keep key in private .env only; DeepL Free/Pro may be metered by provider.
# HUB_TRANSLATE_DEEPL_KEY=
# HUB_TRANSLATE_DEEPL_PLAN=free
